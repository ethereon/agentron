{
    "compilerOptions": {
        "target": "ES2022",

        "module": "NodeNext",
        "moduleResolution": "NodeNext",

        "rootDir": "src",
        "outDir": "dist",

        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,

        "strict": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist"]
}
