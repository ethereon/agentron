{
    "name": "@ethereon/agentypes",
    "version": "0.1.0",
    "description": "Shared types for Agentron packages",
    "license": "MIT",
    "author": "Saumitro Dasgupta",
    "type": "module",
    "main": "index.js",
    "exports": {
        "./*.js": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "require": "./dist/*.js"
        }
    },
    "typesVersions": {
        "*": {
            "*": [
                "dist/*"
            ]
        }
    },
    "devDependencies": {
        "typescript": "^5.9.3"
    }
}
